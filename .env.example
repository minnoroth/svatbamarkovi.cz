# Cloudflare R2 credentials for api/presign.ts — set these in Vercel
# (Settings → Environment Variables) and locally in an untracked `.env`.
# Never commit real values.

# Cloudflare account ID (R2 overview page)
R2_ACCOUNT_ID=
# R2 API token with "Object Read & Write" scoped to the bucket below
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name
R2_BUCKET=svatba-media
# Kill switch — set to "false" after the upload window closes (no redeploy needed)
UPLOADS_ENABLED=true
